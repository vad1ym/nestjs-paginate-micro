{
  "name": "nestjs-paginate-micro",
  "packageManager": "pnpm@11.1.3",
  "version": "1.0.0",
  "author": "Vadym Bulakh <bulakhvad@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vad1ym/nestjs-paginate-micro.git"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist/**/*"
  ],
  "description": "Filtering, search, sorting, and pagination for MikroORM in NestJS.",
  "keywords": [
    "nestjs",
    "mikro-orm",
    "express",
    "pagination",
    "paginate",
    "filtering",
    "search"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:ci": "prettier --list-different \"src/**/*.ts\"",
    "lint": "eslint -c .eslintrc.json --ext .ts --max-warnings 0 src",
    "test": "vitest run src --globals",
    "test:watch": "vitest src --globals",
    "changelog": "changelogen",
    "changelog:dry": "changelogen --no-output",
    "release": "changelogen --release"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.2.2",
    "@mikro-orm/decorators": "7.2.2",
    "@mikro-orm/mysql": "^7.2.2",
    "@mikro-orm/postgresql": "^7.2.2",
    "@mikro-orm/sqlite": "^7.2.2",
    "@nestjs/common": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.1",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "better-sqlite3": "^12.11.1",
    "changelogen": "^0.6.2",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "fastify": "^5.2.1",
    "mysql2": "^3.14.0",
    "pg": "^8.14.0",
    "prettier": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^6.6.0 || ^7.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^11.0.0 || ^12.0.0",
    "express": "^4.21.2 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "changelog": {
    "output": false
  }
}
